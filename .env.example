# KnowBridge AI — Environment Configuration

# Flask Application Secret
SECRET_KEY=knowbridge-ai-production-secret-key-change-in-prod-2026

# JWT Secret Key for REST API Tokens (HS256)
JWT_SECRET_KEY=knowbridge-ai-enterprise-jwt-token-signing-secret-key-super-secure-2026

# Google Gemini API Key (Optional — smart rule-based NLP fallback works offline without any key!)
GEMINI_API_KEY=your-gemini-api-key-here

# Database URI (SQLite for development, PostgreSQL connection string for production)
# SQLite: sqlite:///knowbridge.db
# PostgreSQL: postgresql://username:password@localhost:5432/knowbridge_db
DATABASE_URL=sqlite:///knowbridge.db

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Server Port
PORT=5000
FLASK_DEBUG=1
