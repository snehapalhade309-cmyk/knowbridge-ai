UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600

# ── AI ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Round 3: GitHub Integration ────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
